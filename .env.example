# Skopiuj do .env i uzupełnij.

DOMAIN=yt.example.com

# Hash hasła (Argon2). Wygeneruj poleceniem:
#   docker compose run --rm app python hash_password.py
# i wklej wynik W POJEDYNCZYCH CUDZYSŁOWACH (hash zawiera znaki $).
APP_PASSWORD_HASH=''

# Ważność sesji w dniach.
SESSION_DAYS=30

# Ciasteczko tylko po HTTPS. Ustaw false wyłącznie do testów po http://localhost.
COOKIE_SECURE=true

# Podsieć, z której przychodzi Caddy (musi zgadzać się z docker-compose.yml).
# Tylko od tych adresów aplikacja przyjmuje nagłówek X-Forwarded-For.
TRUSTED_PROXY_NETS=172.31.250.0/24

# Blokada logowania na adres IP: po LOGIN_MAX_FAILS błędach blokada na kolejne
# czasy z LOGIN_LOCK_STEPS (sekundy). Licznik zeruje się po udanym logowaniu
# albo po dobie bez błędów.
LOGIN_MAX_FAILS=5
LOGIN_LOCK_STEPS=900,3600,21600,86400

# Globalny bezpiecznik: przy LOGIN_GLOBAL_MAX_FAILS błędach (z dowolnych IP)
# w ciągu LOGIN_GLOBAL_WINDOW sekund logowanie jest wstrzymane dla wszystkich
# na LOGIN_GLOBAL_LOCK sekund.
LOGIN_GLOBAL_MAX_FAILS=30
LOGIN_GLOBAL_WINDOW=600
LOGIN_GLOBAL_LOCK=900

# Liczba wyników wyszukiwania i filmów na stronę kanału.
SEARCH_LIMIT=24
CHANNEL_PAGE_SIZE=30
